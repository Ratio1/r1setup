# Managed by ratio1.multi_node_launcher
# R1SETUP_SERVICE_FILE_VERSION={{ mnl_service_version }}
[Unit]
Description=MultiNodeLauncher Execution Engine
# Ordered after the container runtime as well: systemd stops units in the reverse
# order, so the node is stopped while the runtime can still deliver the stop signal.
After=docker.service containerd.service
Requires=docker.service
StartLimitBurst={{ mnl_service_start_limit_burst | default(30) }}
StartLimitIntervalSec={{ mnl_service_start_limit_interval_sec | default(1800) }}
StartLimitAction=reboot

[Service]
TimeoutStartSec=0
# systemd waits 150 s for the stop command: 30 s more than the 120 s the node gets below.
TimeoutStopSec=150
Restart=always
RestartSec={{ mnl_service_restart_sec | default(60) }}
Environment="R1SETUP_SERVICE_FILE_VERSION={{ mnl_service_version }}"

# Stop the container if it exists, with the same 120 s as ExecStop: a node that is
# still closing when the unit starts again is not cut short.
ExecStartPre=-/usr/bin/docker stop -t 120 {{ mnl_docker_container_name }}
ExecStartPre=-/usr/bin/docker rm {{ mnl_docker_container_name }}

# Pull the latest image
ExecStartPre=-/usr/bin/docker pull {{ mnl_docker_image_url }}

# Start the container. --stop-timeout gives a stop that does not come from this unit
# (docker stop or docker restart without -t, a daemon shutdown) the same 120 s.
ExecStart=/bin/sh -c '/usr/bin/docker run \
    {% if mnl_image_variant | default('cpu') == 'gpu' %}{{ mnl_docker_gpus }} {% endif %} \
    {{ mnl_port_forward | default('') }} \
    --rm \
    --privileged \
    --cgroupns=host \
    --stop-timeout 120 \
    --name {{ mnl_docker_container_name }} \
    -e EE_ID={{ r1setup_instance_logical_name | default(inventory_hostname, true) }} \
    -e R1SETUP_METADATA_PATH={{ mnl_r1setup_metadata_container_path }} \
    -v {{ mnl_docker_volume_path }}:{{ mnl_docker_persistent_folder }} \
    {{ mnl_docker_image_url }}; \
    echo $? > {{ r1setup_runtime_exit_status_path | default("/tmp/ee-node.exit", true) }}'

ExecStartPost=-/bin/sh -c 'sleep 30; /usr/bin/docker image prune -a -f --filter "until=120h"'

# Stop the container: SIGTERM, then SIGKILL after 120 s. The node's orderly close
# took 61-94 s where it was measured; the previous 20 s cut every close short.
ExecStop=/usr/bin/docker stop -t 120 {{ mnl_docker_container_name }}

# Exit code 10 causes a system reboot
{{ mnl_commented_restart | default('') }}ExecStopPost=/bin/sh -c 'EXIT_STATUS=$(cat {{ r1setup_runtime_exit_status_path | default("/tmp/ee-node.exit", true) }}); if [ "$EXIT_STATUS" -eq 10 ]; then shutdown -r now; fi'

[Install]
WantedBy=multi-user.target
